<?xml version="1.0" encoding="utf-8"?>
<!--
  文件管理页：顶栏（返回 + 标题）+ 三个 tab + 一个列表。

  tab 是三个等宽的文字标签，选中项用琥珀色，
  与设置页的分段选项同一套信号，不引入 TabLayout（不引新依赖）。
  列表项是 paper_2 行 + 1dp 分隔线，最新的排在最上面。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:background="@drawable/bg_top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_xs">

        <TextView
            android:id="@+id/btnBack"
            style="@style/BodyCamTitle"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:contentDescription="@string/action_back"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/glyph_back"
            android:textColor="@color/ink" />

        <TextView
            style="@style/BodyCamTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:text="@string/title_files" />
    </LinearLayout>

    <!-- tab 行：三个等宽标签，共用一条 1dp 底边 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_row"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabImages"
            style="@style/BodyCamLabel"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/tab_images" />

        <TextView
            android:id="@+id/tabVideos"
            style="@style/BodyCamLabel"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/tab_videos" />

        <TextView
            android:id="@+id/tabAudios"
            style="@style/BodyCamLabel"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/tab_audios" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/fileList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/emptyView"
            style="@style/BodyCamHint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/files_empty"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>