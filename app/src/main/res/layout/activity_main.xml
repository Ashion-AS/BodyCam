<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面 = 取景器。除了一条顶栏、底部操作坞和校准行，屏幕上不该有别的浮层。

  分区（和为什么）：
    顶栏   56dp 的信息带：左「仪器读数 + 按键提示」，中「计时」，右「仪器状态 + 设置」
    左下   留给水印（由 GL 直接烧进画面，不在布局里）
    底部   操作坞：拍照 / 录像 / 录音 / 文件，四枚圆形按钮横排，上图标下文字
    顶栏下 调试校准行，可点，只给现场校准方向用

  所有颜色 / 字号 / 间距都来自 values/colors.xml、dimens.xml、styles.xml，
  这里不出现任何写死的颜色值。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <!-- OpenGL 直接往这个 Surface 上画：相机画面 + 烧进去的水印 -->
    <SurfaceView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 拍照时的白屏闪烁 -->
    <View
        android:id="@+id/flashView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/flash" />

    <!-- 顶栏与校准行同一列自上而下排，不用魔法偏移去猜顶栏高度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <!-- 顶栏：与画面之间只用一条 1dp 分隔线，不投影、不做玻璃 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_top_bar"
            android:minHeight="@dimen/top_bar_height"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingVertical="@dimen/space_xs">

            <!-- 左：读数与按键提示，两行等宽字体 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/statusView"
                        style="@style/BodyCamInstrumentOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_booting" />

                    <View
                        android:id="@+id/recDot"
                        android:layout_width="@dimen/status_dot"
                        android:layout_height="@dimen/status_dot"
                        android:layout_marginStart="@dimen/space_xs"
                        android:background="@drawable/dot_rec"
                        android:visibility="invisible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/hintView"
                    style="@style/BodyCamHintOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3xs"
                    android:text="@string/hint_keys" />
            </LinearLayout>

            <!--
              中：录像计时。始终居中，不受左右内容宽度影响。
              红字靠深色投影把紧邻的一圈压暗来立住，不垫底色块，也不描边（描边会加粗字形）。
            -->
            <TextView
                android:id="@+id/timerView"
                style="@style/BodyCamInstrumentLargeOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/timer_zero"
                android:visibility="gone" />

            <!-- 右：预录缓冲状态 + 设置入口 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 黄环：预录缓冲在跑。这是仪器状态，不是录像状态 -->
                <View
                    android:id="@+id/preRecordDot"
                    android:layout_width="@dimen/status_dot"
                    android:layout_height="@dimen/status_dot"
                    android:background="@drawable/dot_pre_record"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/btnSettings"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/space_xs"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/title_settings"
                    android:focusable="true"
                    android:padding="@dimen/space_sm"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>
        </FrameLayout>

        <!--
          方向校准行：现场定位方向问题用，点一次 +90°。
          它承载真实读数（S/D/R、流与输出尺寸），不是装饰文字。
        -->
        <TextView
            android:id="@+id/debugView"
            style="@style/BodyCamInstrumentOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_panel"
            android:clickable="true"
            android:focusable="true"
            android:lineSpacingExtra="@dimen/space_3xs"
            android:paddingHorizontal="@dimen/space_sm"
            android:paddingVertical="@dimen/space_xs"
            android:visibility="gone" />
    </LinearLayout>

    <!--
      底部操作坞：拍照 / 录像 / 录音 / 文件，四枚圆形按钮横排。
      每枚都是「上图标、下文字」，拇指行程最短；录像仍是唯一实心红的主控件。
      录音与文件从这里进，顶栏不再保留同类入口。
    -->
    <LinearLayout
        android:id="@+id/dockBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/space_sm"
        android:layout_marginBottom="@dimen/space_md"
        android:background="@drawable/bg_dock_bar"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_2xs"
        android:paddingVertical="@dimen/space_sm">

        <!-- 拍照 -->
        <LinearLayout
            android:id="@+id/btnShutter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/btn_capture"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="@dimen/space_2xs">

            <ImageView
                android:layout_width="@dimen/dock_button_size"
                android:layout_height="@dimen/dock_button_size"
                android:background="@drawable/bg_dock_button"
                android:importantForAccessibility="no"
                android:padding="@dimen/space_sm"
                android:src="@drawable/ic_capture"
                android:tint="@color/ink" />

            <TextView
                style="@style/BodyCamLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                android:text="@string/btn_capture" />
        </LinearLayout>

        <!-- 录像：主控件 -->
        <LinearLayout
            android:id="@+id/btnRecord"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/btn_record"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="@dimen/space_2xs">

            <ImageView
                android:id="@+id/iconRecord"
                android:layout_width="@dimen/dock_button_size"
                android:layout_height="@dimen/dock_button_size"
                android:background="@drawable/bg_dock_record"
                android:importantForAccessibility="no"
                android:padding="@dimen/space_sm"
                android:src="@drawable/ic_record"
                android:tint="@color/ink" />

            <TextView
                android:id="@+id/labelRecord"
                style="@style/BodyCamLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                android:text="@string/btn_record" />
        </LinearLayout>

        <!-- 录音 -->
        <LinearLayout
            android:id="@+id/btnAudioRecord"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/title_audio_record"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="@dimen/space_2xs">

            <ImageView
                android:layout_width="@dimen/dock_button_size"
                android:layout_height="@dimen/dock_button_size"
                android:background="@drawable/bg_dock_button"
                android:importantForAccessibility="no"
                android:padding="@dimen/space_sm"
                android:src="@drawable/ic_mic"
                android:tint="@color/ink" />

            <TextView
                style="@style/BodyCamLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                android:text="@string/title_audio_record" />
        </LinearLayout>

        <!-- 文件 -->
        <LinearLayout
            android:id="@+id/btnFiles"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/title_files"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="@dimen/space_2xs">

            <ImageView
                android:layout_width="@dimen/dock_button_size"
                android:layout_height="@dimen/dock_button_size"
                android:background="@drawable/bg_dock_button"
                android:importantForAccessibility="no"
                android:padding="@dimen/space_sm"
                android:src="@drawable/ic_folder"
                android:tint="@color/ink" />

            <TextView
                style="@style/BodyCamLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                android:text="@string/title_files" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>