<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面 = 取景器。除了一条顶栏、底部操作坞和校准行，屏幕上不该有别的浮层。

  分区（和为什么）：
    顶栏   56dp 的信息带：左「读数 + 计时」两行，右「仪器状态 + 补光 / 切摄 / 设置」
    左下   留给水印（由 GL 直接烧进画面，不在布局里）
    底部   操作坞：拍照 / 录像 / 录音 / 文件，四枚圆形按钮横排，上图标下文字
    顶栏下 调试校准行，可点，只给现场校准方向用

  所有颜色 / 字号 / 间距都来自 values/colors.xml、dimens.xml、styles.xml，
  这里不出现任何写死的颜色值。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <!-- OpenGL 直接往这个 Surface 上画：相机画面 + 烧进去的水印 -->
    <SurfaceView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 拍照时的白屏闪烁 -->
    <View
        android:id="@+id/flashView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/flash" />

    <!-- 顶栏与校准行同一列自上而下排，不用魔法偏移去猜顶栏高度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <!-- 顶栏：与画面之间只用一条 1dp 分隔线，不投影、不做玻璃 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_top_bar"
            android:minHeight="@dimen/top_bar_height"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/space_2xs"
            android:paddingBottom="@dimen/space_xs">

            <!-- 左：两行上下居中——上为仪器读数，下为录像计时 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:orientation="vertical">

                <!--
                  读数比下面那行计时略大：它是常驻信息，一眼要能读到分辨率与帧率。
                  只在本控件覆盖字号，不动 BodyCamInstrumentOverlay（调试校准行也在用）。
                -->
                <TextView
                    android:id="@+id/statusView"
                    style="@style/BodyCamInstrumentOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_booting"
                    android:textSize="@dimen/text_readout" />

                <!--
                  第二行：录像图标常驻，录像时在它右侧接上红色计时。
                  计时在未录像时保持 INVISIBLE 占位，这样这行的宽高都恒定，
                  录制开始/结束时顶栏不会跳动。
                -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iconRecordStatus"
                        android:layout_width="@dimen/status_icon"
                        android:layout_height="@dimen/status_icon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_record"
                        android:tint="@color/ink" />

                    <TextView
                        android:id="@+id/timerView"
                        style="@style/BodyCamInstrumentLargeOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2xs"
                        android:text="@string/timer_zero"
                        android:visibility="invisible" />
                </LinearLayout>
            </LinearLayout>

            <!-- 右：预录缓冲状态 + 设置入口 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 黄环：预录缓冲在跑。这是仪器状态，不是录像状态 -->
                <View
                    android:id="@+id/preRecordDot"
                    android:layout_width="@dimen/status_dot"
                    android:layout_height="@dimen/status_dot"
                    android:background="@drawable/dot_pre_record"
                    android:visibility="gone" />

                <!-- 补光灯：开着时图标转琥珀，一眼可辨；无闪光灯的机型隐藏 -->
                <ImageView
                    android:id="@+id/btnTorch"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/space_xs"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/action_torch"
                    android:focusable="true"
                    android:padding="@dimen/space_sm"
                    android:src="@drawable/ic_flash"
                    android:tint="@color/muted"
                    android:visibility="gone" />

                <!-- 切换摄像头：多摄机型才显示 -->
                <ImageView
                    android:id="@+id/btnSwitchCamera"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/space_xs"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/action_switch_camera"
                    android:focusable="true"
                    android:padding="@dimen/space_sm"
                    android:src="@drawable/ic_switch_camera"
                    android:tint="@color/muted"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/btnSettings"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/space_xs"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/title_settings"
                    android:focusable="true"
                    android:padding="@dimen/space_sm"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>
        </FrameLayout>

        <!--
          方向校准行：现场定位方向问题用，点一次 +90°。
          它承载真实读数（S/D/R、流与输出尺寸），不是装饰文字。
        -->
        <TextView
            android:id="@+id/debugView"
            style="@style/BodyCamInstrumentOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_panel"
            android:clickable="true"
            android:focusable="true"
            android:lineSpacingExtra="@dimen/space_3xs"
            android:paddingHorizontal="@dimen/space_sm"
            android:paddingVertical="@dimen/space_xs"
            android:visibility="gone" />

        <!--
          延录提示条：按下停止后仍在这段时间里继续录。

          必须显眼且可交互——用户会以为已经停了，所以要给出倒计时，
          并留一个「继续录像」把这次停止撤销掉（对应需求里的
          「延录期间再按录像 → 取消延录、继续正常录像」）。
          用 accent 描边而不是实心：它是一段临时状态，不该和红色录像态抢。
        -->
        <LinearLayout
            android:id="@+id/postRecordBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_sm"
            android:paddingVertical="@dimen/space_xs"
            android:visibility="gone">

            <TextView
                android:id="@+id/postRecordText"
                style="@style/BodyCamInstrumentOverlay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/accent" />

            <TextView
                android:id="@+id/btnPostRecordCancel"
                style="@style/BodyCamLabel"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:layout_marginStart="@dimen/space_sm"
                android:gravity="center"
                android:paddingHorizontal="@dimen/space_sm"
                android:text="@string/post_record_cancel"
                android:textColor="@color/accent" />
        </LinearLayout>
    </LinearLayout>

    <!--
      竖向缩放条：贴右侧边缘、纵向居中，拇指自然落点。
      只在当前摄像头支持数字变焦（zoomMax > 1）时由代码显示，否则 GONE。
    -->
    <com.dsh.bodycam.ui.ZoomSliderView
        android:id="@+id/zoomSlider"
        android:layout_width="@dimen/zoom_slider_width"
        android:layout_height="@dimen/zoom_slider_height"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="@dimen/space_xs"
        android:visibility="gone" />

    <!--
      底部操作坞：拍照 / 录像 / 录音 / 文件，四枚圆形按钮横排。
      每枚都是「上图标、下文字」，拇指行程最短；录像仍是唯一实心红的主控件。
      录音与文件从这里进，顶栏不再保留同类入口。
    -->
    <LinearLayout
        android:id="@+id/dockBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/space_sm"
        android:layout_marginBottom="@dimen/space_md"
        android:background="@drawable/bg_dock_bar"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_2xs"
        android:paddingVertical="@dimen/space_sm">

        <!-- 拍照 -->
        <LinearLayout
            android:id="@+id/btnShutter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/btn_capture"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="@dimen/space_2xs">

            <ImageView
                android:layout_width="@dimen/dock_button_size"
                android:layout_height="@dimen/dock_button_size"
                android:background="@drawable/bg_dock_button"
                android:importantForAccessibility="no"
                android:padding="@dimen/space_sm"
                android:src="@drawable/ic_capture"
                android:tint="@color/ink" />

            <TextView
                style="@style/BodyCamLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                android:text="@string/btn_capture" />
        </LinearLayout>

        <!-- 录像：主控件 -->
        <LinearLayout
            android:id="@+id/btnRecord"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/btn_record"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="@dimen/space_2xs">

            <ImageView
                android:id="@+id/iconRecord"
                android:layout_width="@dimen/dock_button_size"
                android:layout_height="@dimen/dock_button_size"
                android:background="@drawable/bg_dock_record"
                android:importantForAccessibility="no"
                android:padding="@dimen/space_sm"
                android:src="@drawable/ic_record"
                android:tint="@color/ink" />

            <TextView
                android:id="@+id/labelRecord"
                style="@style/BodyCamLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                android:text="@string/btn_record" />
        </LinearLayout>

        <!-- 录音 -->
        <LinearLayout
            android:id="@+id/btnAudioRecord"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/title_audio_record"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="@dimen/space_2xs">

            <ImageView
                android:layout_width="@dimen/dock_button_size"
                android:layout_height="@dimen/dock_button_size"
                android:background="@drawable/bg_dock_button"
                android:importantForAccessibility="no"
                android:padding="@dimen/space_sm"
                android:src="@drawable/ic_mic"
                android:tint="@color/ink" />

            <TextView
                style="@style/BodyCamLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                android:text="@string/title_audio_record" />
        </LinearLayout>

        <!-- 文件 -->
        <LinearLayout
            android:id="@+id/btnFiles"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/title_files"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="@dimen/space_2xs">

            <ImageView
                android:layout_width="@dimen/dock_button_size"
                android:layout_height="@dimen/dock_button_size"
                android:background="@drawable/bg_dock_button"
                android:importantForAccessibility="no"
                android:padding="@dimen/space_sm"
                android:src="@drawable/ic_folder"
                android:tint="@color/ink" />

            <TextView
                style="@style/BodyCamLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                android:text="@string/title_files" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>