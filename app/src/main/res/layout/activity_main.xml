<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- OpenGL 直接往这个 Surface 上画（相机画面 + 水印） -->
    <SurfaceView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 拍照时的白屏闪烁 -->
    <View
        android:id="@+id/flashView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#66000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <View
            android:id="@+id/recDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_rec"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/statusView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/status_booting"
            android:textColor="#E8EEF6"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/timerView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="00:00:00"
            android:textColor="#FF5252"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/hintView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="52dp"
        android:text="@string/hint_keys"
        android:textColor="#DDFFFFFF"
        android:textSize="11sp"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4" />

    <TextView
        android:id="@+id/debugView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="76dp"
        android:fontFamily="monospace"
        android:textColor="#B3FFFFFF"
        android:textSize="10sp"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:visibility="gone" />

    <!-- 按钮放在右下角，避开左下角的水印区域 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnShutter"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_btn_capture"
            android:gravity="center"
            android:text="@string/btn_capture"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnRecord"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/bg_btn_record"
            android:gravity="center"
            android:text="@string/btn_record"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
