<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页：一张「登记表」，不是卡片流。

  结构：按「编码 → 录像 → 拍照 → 录音 → 其他」分区，每区一个 muted 小标题；
  分组标题只是纸面上的栏目名，不铺底色、不加投影。

  编码设置（决定编码器与成片规格）
    行 1  录像分辨率（分段选项）
    行 2  录像帧率（分段选项）
    行 3  录像画质（分段选项）
    行 4  视频声音开关
    行 5  生效时机提示（纯文字）

  录像设置（决定怎么录、录多久、什么时候停）
    行 6  预录开关（标题 + 一句说明 + 开关）
    行 7  预录时长（分段选项，关闭预录时整行降到 40% 不透明度且不可点）
    行 8  延录时长（分段选项，0 = 关闭）
    行 9  分段时长（分段选项）
    行 10 循环录像开关（空间不足时删最早分段）
    行 11 空间告警阈值（分段选项）
    行 12 电量告警阈值（分段选项）
    行 13 存储访问权限（状态 + 去开启）

  拍照设置
    行 14 拍照补光（分段选项）
    行 15 拍照模式（分段选项 + 一句说明）
    行 16 连拍间隔与张数（仅连拍模式显示）
    行 17 拍照质量（分段选项）
    行 18 拍照尺寸（两行两列）

  录音设置
    行 19 录音分段时长（分段选项，与录像分段时长互不影响）

  其他
    行 20 调试校准行开关

  行与行之间共用 1dp 分隔线，行本身是 paper_2；不叠卡片、不加投影。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:background="@drawable/bg_top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_xs">

        <TextView
            android:id="@+id/btnBack"
            style="@style/BodyCamTitle"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:contentDescription="@string/action_back"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/glyph_back"
            android:textColor="@color/ink" />

        <TextView
            style="@style/BodyCamTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:text="@string/title_settings" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_xl">

            <!-- ==================== 编码设置 ==================== -->

            <TextView
                style="@style/BodyCamSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingTop="@dimen/space_lg"
                android:paddingBottom="@dimen/space_xs"
                android:text="@string/settings_section_encode" />

            <!-- 行 1：录像分辨率 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <TextView
                    style="@style/BodyCamLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_video_size_title" />

                <RadioGroup
                    android:id="@+id/rgVideoSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/BodyCamHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:text="@string/settings_video_size_summary" />
            </LinearLayout>

            <!-- 行 2：录像帧率 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <TextView
                    style="@style/BodyCamLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_video_fps_title" />

                <RadioGroup
                    android:id="@+id/rgVideoFps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/BodyCamHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:text="@string/settings_video_fps_summary" />
            </LinearLayout>

            <!-- 行 3：录像画质 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <TextView
                    style="@style/BodyCamLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_video_quality_title" />

                <RadioGroup
                    android:id="@+id/rgVideoQuality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/BodyCamHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:text="@string/settings_video_quality_summary" />
            </LinearLayout>

            <!-- 行 4：视频声音开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BodyCamLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_video_audio_title" />

                    <TextView
                        style="@style/BodyCamHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2xs"
                        android:text="@string/settings_video_audio_summary" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swVideoAudio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:minWidth="@dimen/touch_target"
                    android:minHeight="@dimen/touch_target" />
            </LinearLayout>

            <!-- 行 5：录像加密开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BodyCamLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_video_encrypt_title" />

                    <TextView
                        style="@style/BodyCamHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2xs"
                        android:text="@string/settings_video_encrypt_summary" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swVideoEncrypt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:minWidth="@dimen/touch_target"
                    android:minHeight="@dimen/touch_target" />
            </LinearLayout>

            <!-- 行 6：录像密钥（32 个字符） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <TextView
                    style="@style/BodyCamLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_video_encrypt_key_title" />

                <TextView
                    style="@style/BodyCamHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:text="@string/settings_video_encrypt_key_summary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etVideoEncryptKey"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pre_record_option"
                        android:hint="@string/settings_video_encrypt_key_placeholder"
                        android:importantForAutofill="no"
                        android:inputType="textVisiblePassword"
                        android:maxLength="32"
                        android:minHeight="@dimen/touch_target"
                        android:paddingHorizontal="@dimen/space_md"
                        android:singleLine="true"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/muted"
                        android:textSize="@dimen/text_md" />

                    <TextView
                        android:id="@+id/btnVideoEncryptKeySave"
                        style="@style/BodyCamLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target"
                        android:layout_marginStart="@dimen/space_sm"
                        android:background="@drawable/bg_pre_record_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/space_md"
                        android:text="@string/action_save"
                        android:textColor="@color/accent" />
                </LinearLayout>
            </LinearLayout>

            <!-- 行 7：生效时机提示 -->
            <TextView
                style="@style/BodyCamHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_sm"
                android:text="@string/settings_video_next_run_hint" />

            <!-- ==================== 录像设置 ==================== -->

            <TextView
                style="@style/BodyCamSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingTop="@dimen/space_lg"
                android:paddingBottom="@dimen/space_xs"
                android:text="@string/settings_section_record" />

            <!-- 行 6：预录开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BodyCamLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_pre_record_title" />

                    <TextView
                        style="@style/BodyCamHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2xs"
                        android:text="@string/settings_pre_record_summary" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swPreRecord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:minWidth="@dimen/touch_target"
                    android:minHeight="@dimen/touch_target" />
            </LinearLayout>

            <!-- 行 7：预录时长 -->
            <LinearLayout
                android:id="@+id/durationSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <TextView
                    style="@style/BodyCamLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_pre_record_duration_title" />

                <RadioGroup
                    android:id="@+id/rgDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- 行 8：延录时长（0 = 关闭） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <TextView
                    style="@style/BodyCamLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_post_record_title" />

                <RadioGroup
                    android:id="@+id/rgPostRecord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/BodyCamHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:text="@string/settings_post_record_summary" />
            </LinearLayout>

            <!-- 行 9：分段时长 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <TextView
                    style="@style/BodyCamLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_segment_title" />

                <!--
                   分段时长：5 档且带「分钟」后缀，一行排不下会被压扁变形，
                   改成每行 4 格、共 2 行，每格等宽。
                -->
                <LinearLayout
                    android:id="@+id/llSegmentMinutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="vertical" />

                <TextView
                    style="@style/BodyCamHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:text="@string/settings_segment_summary" />
            </LinearLayout>

            <!-- 行 10：循环录像开关（默认关闭） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BodyCamLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_loop_record_title" />

                    <TextView
                        style="@style/BodyCamHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2xs"
                        android:text="@string/settings_loop_record_summary" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swLoopRecord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:minWidth="@dimen/touch_target"
                    android:minHeight="@dimen/touch_target" />
            </LinearLayout>

            <!-- 行 11：空间告警阈值 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <TextView
                    style="@style/BodyCamLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_disk_warn_title" />

                <RadioGroup
                    android:id="@+id/rgDiskWarn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/BodyCamHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:text="@string/settings_disk_warn_summary" />
            </LinearLayout>

            <!-- 行 12：电量告警阈值 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <TextView
                    style="@style/BodyCamLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_battery_warn_title" />

                <RadioGroup
                    android:id="@+id/rgBatteryWarn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/BodyCamHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:text="@string/settings_battery_warn_summary" />
            </LinearLayout>

            <!-- 行 13：存储访问权限 -->
            <LinearLayout
                android:id="@+id/storageRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BodyCamLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_storage_title" />

                    <TextView
                        android:id="@+id/storageStatus"
                        style="@style/BodyCamHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2xs" />
                </LinearLayout>

                <TextView
                    android:id="@+id/storageAction"
                    style="@style/BodyCamLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/space_sm"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/space_sm"
                    android:textColor="@color/accent" />
            </LinearLayout>

            <!-- ==================== 拍照设置 ==================== -->

            <TextView
                style="@style/BodyCamSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingTop="@dimen/space_lg"
                android:paddingBottom="@dimen/space_xs"
                android:text="@string/settings_section_photo" />

            <!-- 行 14：拍照补光 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <TextView
                    style="@style/BodyCamLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_photo_flash_title" />

                <RadioGroup
                    android:id="@+id/rgPhotoFlash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/BodyCamHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:text="@string/settings_photo_flash_summary" />
            </LinearLayout>

            <!-- 行 15：拍照模式（单拍 / 连拍） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <TextView
                    style="@style/BodyCamLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_photo_mode_title" />

                <RadioGroup
                    android:id="@+id/rgPhotoMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/photoModeSummary"
                    style="@style/BodyCamHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xs" />
            </LinearLayout>

            <!-- 行 16：连拍间隔与张数（仅连拍模式显示） -->
            <LinearLayout
                android:id="@+id/burstSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <TextView
                    style="@style/BodyCamLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_burst_interval_title" />

                <RadioGroup
                    android:id="@+id/rgBurstInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/BodyCamLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/settings_burst_count_title" />

                <RadioGroup
                    android:id="@+id/rgBurstCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/BodyCamHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:text="@string/settings_burst_summary" />
            </LinearLayout>

            <!-- 行 17：拍照质量 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <TextView
                    style="@style/BodyCamLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_photo_quality_title" />

                <RadioGroup
                    android:id="@+id/rgPhotoQuality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/BodyCamHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:text="@string/settings_photo_quality_summary" />
            </LinearLayout>

            <!-- 行 18：拍照尺寸 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <TextView
                    style="@style/BodyCamLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_photo_size_title" />

                <!--
                   拍照尺寸：四档标签较长，一行两个、两行排布，
                   每格等宽，避免挤在一行时被压扁变形。
                -->
                <LinearLayout
                    android:id="@+id/llPhotoSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="vertical" />

                <TextView
                    style="@style/BodyCamHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:text="@string/settings_photo_size_summary" />
            </LinearLayout>

            <!-- ==================== 录音设置 ==================== -->

            <TextView
                style="@style/BodyCamSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingTop="@dimen/space_lg"
                android:paddingBottom="@dimen/space_xs"
                android:text="@string/settings_section_audio" />

            <!-- 行 19：录音分段时长 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <TextView
                    style="@style/BodyCamLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_segment_title" />

                <!--
                   与录像分段时长同样排成每行 4 格、共 2 行，保持两处观感一致。
                -->
                <LinearLayout
                    android:id="@+id/llAudioSegmentMinutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="vertical" />

                <TextView
                    style="@style/BodyCamHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:text="@string/settings_audio_segment_summary" />
            </LinearLayout>

            <!-- ==================== 其他 ==================== -->

            <TextView
                style="@style/BodyCamSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingTop="@dimen/space_lg"
                android:paddingBottom="@dimen/space_xs"
                android:text="@string/settings_section_other" />

            <!-- 行 20：调试校准行开关（默认关闭） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BodyCamLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_debug_overlay_title" />

                    <TextView
                        style="@style/BodyCamHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2xs"
                        android:text="@string/settings_debug_overlay_summary" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swDebugOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:minWidth="@dimen/touch_target"
                    android:minHeight="@dimen/touch_target" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>