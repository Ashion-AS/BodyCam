<?xml version="1.0" encoding="utf-8"?>
<!--
  底部操作坞：一块圆角深底，四枚圆形按钮共用一个地面。
  用 scrim_dock（比顶栏的 scrim_well 透一档），让取景画面透出来，
  又靠按钮自带的实底和文字阴影保证可读性。不描边：深底压在画面上时
  那圈细线反而显脏。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/scrim_dock" />
    <corners android:radius="@dimen/radius_panel" />
</shape>