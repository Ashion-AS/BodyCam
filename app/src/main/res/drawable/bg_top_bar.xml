<?xml version="1.0" encoding="utf-8"?>
<!-- 顶栏：与画面之间只用一条 1dp 分隔线，不加投影、不做玻璃 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/scrim_bar" />
        </shape>
    </item>
    <item
        android:gravity="bottom"
        android:height="@dimen/rule_hair">
        <shape android:shape="rectangle">
            <solid android:color="@color/rule" />
        </shape>
    </item>
</layer-list>
