<?xml version="1.0" encoding="utf-8"?>
<!--
  次要控件：拍照。
  键盘/开关控制聚焦时换 2dp 琥珀描边（与录像键同一个信号色，不引入第二种强调）；
  其余状态是 1dp rule_2 描边 + 水波。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/scrim_well" />
            <stroke
                android:width="@dimen/rule_strong"
                android:color="@color/accent" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>

    <item>
        <ripple android:color="@color/ripple_on_paper">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/scrim_well" />
                    <stroke
                        android:width="@dimen/rule_hair"
                        android:color="@color/rule_2" />
                    <corners android:radius="@dimen/radius_control" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
