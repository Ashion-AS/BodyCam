<?xml version="1.0" encoding="utf-8"?>
<!--
  下拉弹层底板：paper_2 底 + rule_2 描边 + radius_panel 圆角，
  与设置页的行同色，靠 elevation 和描边把它从页面上"抬"起来。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/paper_2" />
    <corners android:radius="@dimen/radius_panel" />
    <stroke
        android:width="@dimen/rule_hair"
        android:color="@color/rule_2" />
</shape>
