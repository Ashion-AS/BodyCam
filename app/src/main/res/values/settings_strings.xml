<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="title_settings">设置</string>

    <!-- 分组标题 -->
    <string name="settings_section_encode">编码设置</string>
    <string name="settings_section_record">录像设置</string>
    <string name="settings_section_photo">拍照设置</string>
    <string name="settings_section_audio">录音设置</string>
    <string name="settings_section_watermark">水印</string>
    <string name="settings_section_other">其他</string>
    <string name="settings_pre_record_title">预录功能</string>
    <string name="settings_pre_record_summary">开始录像前持续缓存画面与声音；开启后耗电与内存占用会增加</string>
    <string name="settings_pre_record_duration_title">预录时长</string>
    <string name="settings_pre_record_duration_fmt">%1$d 秒</string>
    <string name="settings_post_record_title">延录时长</string>
    <string name="settings_post_record_fmt">%1$d 秒</string>
    <string name="settings_post_record_off">关闭</string>
    <string name="settings_post_record_summary">按下停止后再多录这么久才收尾，成片与主体录像连在同一个文件里；延录中会显示倒计时，可再按一次立即停止</string>

    <string name="settings_storage_title">文件存储权限</string>
    <string name="settings_storage_granted">已开启，录像/照片/录音会保存到 BodyCam 目录</string>
    <string name="settings_storage_missing">未开启，将无法保存文件。需在系统设置中允许「所有文件访问」</string>
    <string name="settings_storage_open">去开启</string>
    <string name="settings_storage_done">已开启</string>

    <string name="settings_storage_mode_title">存储位置</string>
    <string name="settings_storage_mode_default">默认存储</string>
    <string name="settings_storage_mode_compat">兼容存储</string>
    <string name="settings_storage_mode_summary">默认存储写到公共目录，其它应用和文件管理器可见；兼容存储写到应用私有目录，无需存储权限、兼容性更好，但卸载应用会一并删除</string>
    <string name="settings_storage_mode_switched">已切换存储位置，仅影响之后保存的文件</string>

    <string name="settings_loop_record_title">循环录像</string>
    <string name="settings_loop_record_summary">空间不足时自动删除最早的录像分段腾出空间；关闭则提示空间不足并停止录像。正在写入的分段始终保留</string>
    <string name="settings_disk_warn_title">空间告警阈值</string>
    <string name="settings_disk_warn_summary">剩余空间低于该值时告警；强制停录线约为它的五分之一（最低 100MB）</string>
    <string name="settings_disk_warn_fmt">%1$d MB</string>

    <string name="settings_battery_warn_title">电量告警阈值</string>
    <string name="settings_battery_warn_summary">电量低于该值时告警；强制停录线约为它的三分之一（最低 5%）。充电中不会触发。息屏录像同样生效</string>
    <string name="settings_battery_warn_fmt">%1$d%%</string>

    <string name="settings_debug_overlay_title">调试校准行</string>
    <string name="settings_debug_overlay_summary">主页预览左上角显示 S/D/R 角度与流尺寸，点一下循环校准方向。仅现场排障用，正式使用建议关闭</string>

    <string name="settings_section_ui">UI 设置</string>
    <string name="settings_top_bar_rule_title">顶栏描边</string>
    <string name="settings_top_bar_rule_summary">在顶部信息栏的上下各加一条 1dp 细线，与取景画面之间界限更清楚。关闭时顶栏与画面自然衔接</string>
    <string name="settings_dock_rule_title">操作坞描边</string>
    <string name="settings_dock_rule_summary">在底部操作坞外圈加一条 1dp 细线。深底压在画面上时这圈线可能显脏，默认关闭</string>
    <string name="settings_zoom_slider_length_title">缩放条长度</string>
    <string name="settings_zoom_slider_length_summary">右侧竖向变焦条的竖向长度。短/中/长依次加长，长的长度与旧版本一致</string>
    <string name="settings_zoom_slider_length_short">短</string>
    <string name="settings_zoom_slider_length_medium">中</string>
    <string name="settings_zoom_slider_length_long">长</string>

    <string name="settings_photo_flash_title">拍照补光</string>
    <string name="settings_photo_flash_summary">只影响拍照；录像过程中需要补光时，用主界面顶栏的闪电按钮开常亮</string>
    <string name="settings_photo_flash_off">关闭</string>
    <string name="settings_photo_flash_auto">自动</string>
    <string name="settings_photo_flash_always">强制</string>

    <string name="settings_photo_mode_title">拍照模式</string>
    <string name="settings_photo_mode_single">单拍</string>
    <string name="settings_photo_mode_burst">连拍</string>
    <string name="settings_photo_mode_summary_single">按一次快门拍一张</string>
    <string name="settings_photo_mode_summary_burst">按一次快门连续拍多张，每张单独保存</string>

    <string name="settings_photo_quality_title">拍照质量</string>
    <string name="settings_photo_quality_high">高</string>
    <string name="settings_photo_quality_medium">中</string>
    <string name="settings_photo_quality_low">低</string>
    <string name="settings_photo_quality_summary">质量越高文件越大，单张写盘也越慢</string>

    <string name="settings_photo_size_title">拍照尺寸</string>
    <string name="settings_photo_size_px_fmt">%1$d×%2$d（%3$dM）</string>
    <string name="settings_photo_size_summary">设备不支持时会自动回退到最接近的可用档；与视频同为 16:9，构图一致</string>

    <string name="settings_burst_interval_title">拍照间隔</string>
    <string name="settings_burst_interval_fmt">%1$d 秒</string>
    <string name="settings_burst_count_title">连拍数目</string>
    <string name="settings_burst_count_fmt">%1$d 张</string>

    <!-- 录像参数 -->
    <string name="settings_video_size_title">录像分辨率</string>
    <string name="settings_video_size_summary">设备不支持时会自动回退到最接近的可用档；竖屏输出为短边×长边（如 1080×1920）</string>
    <string name="settings_video_fps_title">录像帧率</string>
    <string name="settings_video_fps_fmt">%1$d fps</string>
    <string name="settings_video_fps_summary">帧率越高画面越流畅，码率与功耗也越高</string>
    <string name="settings_video_quality_title">录像画质</string>
    <string name="settings_video_quality_summary">码率随分辨率与帧率自动换算：4K 高档约 25Mbps，1080P 高档约 6Mbps</string>
    <string name="settings_segment_title">分段时长</string>
    <string name="settings_segment_fmt">%1$d 分钟</string>
    <string name="settings_segment_summary">每隔这么久换一个新文件；切换在关键帧处进行，不丢画面</string>
    <string name="settings_audio_segment_summary">每隔这么久换一个录音文件；切换时编码器不中断，只在文件边界切一刀</string>
    <string name="settings_video_audio_title">视频声音</string>
    <string name="settings_video_audio_summary">关闭后录像不带声音，文件里只有视频轨；录音功能不受影响</string>
    <string name="settings_video_next_run_hint">分辨率、帧率与画质在下次开始录像时生效</string>
    <string name="settings_video_encrypt_title">录像加密</string>
    <string name="settings_video_encrypt_summary">开启后录像文件内容用 AES-256 加密，回放时需输入密钥；录音与照片不受影响</string>
    <string name="settings_video_encrypt_key_title">录像密钥</string>
    <string name="settings_video_encrypt_key_summary">32 个字符，字母数字符号均可；遗失后已加密的录像将无法播放</string>
    <string name="settings_video_encrypt_key_placeholder">请输入 32 位录像密钥</string>
    <string name="settings_video_encrypt_key_saved">密钥已保存</string>
    <string name="settings_video_encrypt_key_invalid">密钥必须是 32 个字符</string>
    <string name="settings_video_encrypt_need_key">请先设置 32 位录像密钥</string>
    <string name="settings_burst_summary">间隔越短、张数越多，连拍总时长越长；连拍期间屏幕保持预览</string>

    <!-- 水印 -->
    <string name="settings_watermark_corners_title">四角内容</string>
    <string name="settings_watermark_corners_summary">照片与录像共用同一套布局；四角各自独立设置，选「不显示」即留空</string>
    <string name="settings_watermark_top_left">左上角</string>
    <string name="settings_watermark_top_right">右上角</string>
    <string name="settings_watermark_bottom_left">左下角</string>
    <string name="settings_watermark_bottom_right">右下角</string>
    <string name="settings_watermark_field_gps">经纬度</string>
    <string name="settings_watermark_field_time">日期时间</string>
    <string name="settings_watermark_field_device_status">SN + 录像状态</string>
    <string name="settings_watermark_field_group_user">分组 + 用户</string>
    <string name="settings_watermark_field_none">不显示</string>
    <string name="settings_watermark_group_title">右下角分组名 / 用户名</string>
    <string name="settings_watermark_group_hint">默认组</string>
    <string name="settings_watermark_user_title">用户名</string>
    <string name="settings_watermark_user_hint">user1</string>
    <string name="settings_watermark_group_summary">留空则使用默认值「默认组」/「user1」；接入平台后由平台下发的值覆盖</string>

    <string name="photo_burst_done_fmt">已保存 %1$d 张</string>
    <string name="photo_burst_blocked_recording">录像中不进入连拍，请先停止录像</string>
    <string name="photo_burst_cancelled">连拍已取消</string>
</resources>
